+def _origin_deliver_needs_target(deliver: Optional[str], origin: Optional[dict]) -> Optional[str]:
+    """Refuse deliver=origin when no origin was captured and no project: slug is set."""
+    tokens = [
+        part.strip().lower()
+        for part in str(deliver or "").split(",")
+        if part.strip()
+    ]
+    if not tokens or "origin" not in tokens:
+        return None
+    if any(part.startswith("project:") for part in tokens):
+        return None
+    if origin and origin.get("chat_id"):
+        return None
+    return (
+        "deliver=origin has no captured origin session. "
+        "Use deliver='project:<slug>' so the job writes into the dedicated "
+        "project conversation."
+    )
 
 
